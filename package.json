{
  "name": "authrim",
  "version": "0.4.0",
  "description": "A scalable Edge Identity Provider built on Cloudflare Workers - OIDC, OAuth 2.0, SAML",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build --filter=!@authrim/ar-admin-ui --filter=!@authrim/ar-login-ui",
    "build:admin-ui": "turbo run build --filter=@authrim/ar-admin-ui",
    "build:login-ui": "turbo run build --filter=@authrim/ar-login-ui",
    "dev": "turbo run dev --parallel",
    "deploy": "./scripts/deploy-with-retry.sh --api-only",
    "deploy:with-router": "./scripts/deploy-with-retry.sh --api-only",
    "deploy:retry": "./scripts/deploy-with-retry.sh --api-only",
    "deploy:ui": "./scripts/deploy-ui.sh",
    "deploy:api": "./scripts/deploy-with-retry.sh --api-only",
    "deploy:all": "./scripts/deploy-all.sh",
    "test": "turbo run test --concurrency=4 && pnpm control-plane:test && pnpm conformance:test && pnpm test:integration && pnpm test:security-matrices",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:security-matrices": "vitest run --config vitest.security-matrices.config.ts",
    "test:security-matrices:typecheck": "tsc --noEmit -p test/security-matrices/tsconfig.json",
    "test:oauth-oidc-regressions": "node test/regression-gates/oauth-oidc/run.mjs",
    "test:ui": "turbo run test --filter=@authrim/ar-admin-ui --filter=@authrim/ar-login-ui",
    "test:coverage": "pnpm run test:coverage:api",
    "test:coverage:api": "turbo run test --filter=!@authrim/ar-admin-ui --filter=!@authrim/ar-login-ui -- --coverage",
    "test:coverage:critical": "turbo run test --filter=@authrim/ar-auth --filter=@authrim/ar-token --filter=@authrim/ar-management --filter=@authrim/ar-lib-core --filter=@authrim/ar-lib-logging --filter=@authrim/ar-lib-policy --filter=@authrim/ar-saml -- --coverage",
    "test:multi-tenant-conformance": "pnpm exec vitest run test/integration/unified-control-plane-runtime-smoke.test.ts test/integration/tenant-system/oidc-cross-tenant-challenge.test.ts packages/ar-auth/src/__tests__/control-plane-runtime-boundary.test.ts packages/ar-token/src/__tests__/control-plane-runtime-boundary.test.ts packages/ar-management/src/__tests__/admin-route-access.test.ts packages/ar-management/src/__tests__/machine-access-router.test.ts packages/ar-management/src/__tests__/pii-partitions.test.ts packages/ar-management/src/__tests__/admin.test.ts packages/ar-management/src/__tests__/admin-users-totp.test.ts packages/ar-management/src/__tests__/policy.test.ts packages/ar-management/src/__tests__/user-import-jobs.test.ts packages/ar-saml/src/common/__tests__/tenant.test.ts packages/ar-saml/src/common/__tests__/saml-signing-keys.test.ts packages/ar-saml/src/sp/__tests__/conditions.test.ts packages/ar-saml/src/__tests__/saml-integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:lighthouse": "lhci autorun",
    "test:lighthouse:collect": "lhci collect",
    "test:lighthouse:assert": "lhci assert",
    "asvs:check": "node scripts/asvs-check.mjs",
    "asvs:check:enforce": "node scripts/asvs-check.mjs --enforce-no-gaps",
    "openapi:validate": "node scripts/validate-openapi.mjs",
    "openapi:routes": "node scripts/openapi-route-inventory.mjs",
    "openapi:backfill-routes": "node scripts/backfill-openapi-route-stubs.mjs",
    "openapi:refine-docs": "node scripts/refine-openapi-docs.mjs",
    "docs:api": "node scripts/build-api-docs.mjs",
    "docs:api:sync-website": "node scripts/sync-api-docs-to-website.mjs",
    "conformance:run": "node --import tsx scripts/oidf-conformance-gate/run-conformance.ts",
    "conformance:basic": "node --import tsx scripts/oidf-conformance-gate/run-conformance.ts --plan basic-op",
    "conformance:config": "node --import tsx scripts/oidf-conformance-gate/run-conformance.ts --plan config-op",
    "conformance:dynamic": "node --import tsx scripts/oidf-conformance-gate/run-conformance.ts --plan dynamic-op",
    "conformance:fapi2": "node --import tsx scripts/oidf-conformance-gate/run-conformance.ts --plan fapi-2",
    "conformance:all": "node --import tsx scripts/oidf-conformance-gate/run-conformance.ts --plan all",
    "conformance:details": "node --import tsx scripts/oidf-conformance-gate/get-test-details.ts",
    "conformance:errors": "node --import tsx scripts/oidf-conformance-gate/get-test-details.ts --failed-only",
    "conformance:openid4vc:metadata": "node --import tsx scripts/oidf-conformance-gate/check-openid4vc-metadata.ts",
    "conformance:test": "vitest run --config scripts/oidf-conformance-gate/vitest.config.ts",
    "conformance:typecheck": "tsc --noEmit -p scripts/oidf-conformance-gate/tsconfig.json",
    "control-plane:phase0-spike": "tsx scripts/control-plane/phase0-live-spike.ts",
    "control-plane:phase0c-fixture": "tsx scripts/control-plane/phase0c-identifier-fixture.ts",
    "control-plane:phase0c-mail-otp": "tsx scripts/control-plane/phase0c-mail-otp-live.ts",
    "control-plane:phase0c-totp-smoke": "tsx scripts/control-plane/phase0c-totp-smoke-live.ts",
    "control-plane:phase0c-totp-load": "tsx scripts/control-plane/phase0c-totp-load-live.ts",
    "control-plane:phase0c-totp-repair": "tsx scripts/control-plane/phase0c-totp-repair-live.ts",
    "control-plane:phase0b-capacity": "tsx scripts/control-plane/phase0b-d1-capacity.ts",
    "control-plane:phase0c-gate": "tsx scripts/control-plane/phase0c-performance-gate.ts",
    "control-plane:phase9-local-gate": "pnpm --filter @authrim/ar-lib-logging build && pnpm --filter @authrim/ar-lib-field-mapping build && pnpm --filter @authrim/ar-lib-core build && pnpm --filter @authrim/ar-lib-plugin build && pnpm --filter @authrim/ar-lib-core exec vitest run src/services/__tests__/tenant-database-resolver.test.ts src/services/__tests__/tenant-runtime-registry-snapshot.test.ts src/services/lookup-directory/__tests__/routing-characterization.test.ts src/services/lookup-directory/__tests__/resolver.test.ts src/services/lookup-directory/__tests__/d1-session-repository.test.ts && pnpm --filter @authrim/ar-control exec vitest run src/__tests__/account-allocation.integration.test.ts src/__tests__/control-service.test.ts src/__tests__/lookup-bucket-migration.integration.test.ts src/__tests__/lookup-hmac-rotation.integration.test.ts src/__tests__/migration-engine.test.ts src/__tests__/worker-binding-reconciler.test.ts && pnpm --filter @authrim/ar-management exec vitest run src/__tests__/account-directory-coordinator.integration.test.ts src/__tests__/cross-shard-account-list.integration.test.ts src/__tests__/directory-routing-outbox.integration.test.ts src/__tests__/discovery-email-otp.integration.test.ts src/__tests__/tenant-runtime-registry-route-state.test.ts && pnpm --filter @authrim/ar-plugin-runner exec vitest run src/__tests__/egress-policy.test.ts src/__tests__/outbound-gateway.integration.test.ts && pnpm --filter @authrim/setup exec vitest run src/__tests__/worker-deployment-lease.test.ts",
    "control-plane:test": "pnpm --filter @authrim/ar-lib-core build && vitest run --config scripts/control-plane/vitest.config.ts",
    "control-plane:typecheck": "tsc --noEmit -p scripts/control-plane/tsconfig.json",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && pnpm conformance:typecheck && pnpm control-plane:typecheck && pnpm release:migrations:typecheck && pnpm test:security-matrices:typecheck && pnpm migrate:manifest:check",
    "format": "prettier --write \"packages/**/*.ts\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"packages/ar-agent-access/scripts/*.mjs\" \"scripts/control-plane/**/*.{ts,json}\" \"scripts/oidf-conformance-gate/**/*.{ts,md,json}\"",
    "security:audit": "pnpm --package=pnpm@11.4.0 dlx pnpm --pm-on-fail=ignore audit --audit-level=moderate",
    "security:mcp-registry": "node scripts/check-mcp-server-registry.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "generate-keys": "tsx scripts/generate-keys.ts",
    "migrate:create": "tsx scripts/create-migration.ts",
    "migrate:manifest": "tsx scripts/release-migrations-cli.ts draft",
    "migrate:manifest:check": "tsx scripts/release-migrations-cli.ts check",
    "release:migrations": "tsx scripts/release-migrations-cli.ts prepare",
    "release:migrations:baseline": "tsx scripts/release-migrations-cli.ts baseline",
    "release:migrations:semantic": "tsx scripts/semantic-baseline-migrations.ts",
    "release:migrations:typecheck": "tsc --noEmit -p scripts/release-migrations-tsconfig.json",
    "migrate:info": "echo '\n📋 Migration Commands:\n\n  migrate:create <name>  - Create a new migration file\n\nFresh installs and existing environments are applied by the manifest-aware @authrim/setup runner.\nFor repository D1 maintenance, use scripts/apply-migrations.sh with --env and --role; do not loop over SQL files directly.\n'",
    "setup": "tsx packages/setup/src/index.ts",
    "setup:init": "tsx packages/setup/src/index.ts init",
    "setup:manage": "tsx packages/setup/src/index.ts manage",
    "setup:deploy": "tsx packages/setup/src/index.ts deploy",
    "setup:status": "tsx packages/setup/src/index.ts status",
    "setup:info": "tsx packages/setup/src/index.ts info",
    "setup:validate-generated-env": "tsx test/generated-environment/validate-generated-env.ts",
    "setup:smoke-generated-api": "tsx test/generated-environment/smoke-generated-api.ts",
    "setup:smoke-generated-admin-api": "tsx test/generated-environment/smoke-generated-admin-api.ts",
    "setup:smoke-generated-auth-flow": "tsx test/generated-environment/smoke-generated-auth-flow.ts",
    "setup:smoke-generated-approvals": "tsx test/generated-environment/smoke-generated-approvals.ts",
    "setup:smoke-generated-server-surfaces": "tsx test/generated-environment/smoke-generated-server-surfaces.ts",
    "admin-ui:issue-session": "tsx tools/admin-ui-session/issue-session.ts",
    "setup:smoke-remote-logging": "tsx test/generated-environment/remote-logging/smoke-remote-logging-output.ts",
    "setup:load-generated-live-safe": "tsx test/generated-environment/load-generated-live-safe.ts",
    "setup:local-capacity": "tsx test/generated-environment/local-capacity.ts",
    "setup:local-user-scale": "tsx test/generated-environment/local-user-scale.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "openid-connect",
    "oidc",
    "oauth2",
    "cloudflare-workers",
    "identity-provider",
    "authentication"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "hono": "4.13.2",
    "jose": "^6.2.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cloudflare/workers-types": "^4.20251121.0",
    "@esbuild/win32-x64": "^0.25.12",
    "@eslint/js": "^9.39.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.19.25",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^4.1.8",
    "axe-core": "^4.11.0",
    "eslint": "^9.39.1",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "turbo": "^2.9.17",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.110.0",
    "yaml": "2.8.3"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.25.12"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.15.2",
      "ajv@<6.14.0": "6.15.0",
      "brace-expansion@<5.0.9": "5.0.9",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "yaml@>=1.0.0 <1.10.3": "1.10.3",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "vite@7.3.5>yaml": "2.8.3",
      "postcss": ">=8.5.18",
      "ip-address": ">=10.2.2",
      "ws": ">=8.21.0",
      "uuid": ">=11.1.1",
      "lodash": ">=4.18.0",
      "lodash-es": ">=4.18.0",
      "tmp": ">=0.2.6",
      "cookie": ">=0.7.0",
      "basic-ftp": ">=5.3.1",
      "path-to-regexp@<0.1.13": "0.1.13",
      "picomatch": ">=4.0.4",
      "undici": ">=8.9.0",
      "defu": ">=6.1.5",
      "vite": ">=7.3.2",
      "@sveltejs/kit": ">=2.70.2",
      "rollup": ">=4.59.0",
      "hono": "4.13.2",
      "jose": "6.2.9",
      "@hono/node-server": "2.0.10",
      "fast-uri": "3.1.5",
      "sharp": "0.35.0",
      "tar": "^7.5.21",
      "devalue": "^5.8.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "@xmldom/xmldom": "^0.8.13",
      "dompurify": "3.4.13",
      "nanoid@<3.3.18": "3.3.18",
      "nanoid@>=4.0.0 <5.1.16": "5.1.16",
      "esbuild": "0.28.1",
      "degit": "2.8.6"
    }
  }
}
