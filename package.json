{
  "name": "authrim",
  "version": "0.3.3",
  "description": "A scalable Edge Identity Provider built on Cloudflare Workers - OIDC, OAuth 2.0, SAML",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build --filter=!@authrim/ar-admin-ui --filter=!@authrim/ar-login-ui",
    "build:admin-ui": "turbo run build --filter=@authrim/ar-admin-ui",
    "build:login-ui": "turbo run build --filter=@authrim/ar-login-ui",
    "dev": "turbo run dev --parallel",
    "deploy": "./scripts/deploy-with-retry.sh --api-only",
    "deploy:with-router": "./scripts/deploy-with-retry.sh --api-only",
    "deploy:retry": "./scripts/deploy-with-retry.sh --api-only",
    "deploy:ui": "./scripts/deploy-ui.sh",
    "deploy:api": "./scripts/deploy-with-retry.sh --api-only",
    "deploy:all": "./scripts/deploy-all.sh",
    "test": "turbo run test",
    "test:ui": "turbo run test --filter=@authrim/ar-admin-ui --filter=@authrim/ar-login-ui",
    "test:coverage": "pnpm run test:coverage:api",
    "test:coverage:api": "turbo run test --filter=!@authrim/ar-admin-ui --filter=!@authrim/ar-login-ui -- --coverage",
    "test:coverage:critical": "turbo run test --filter=@authrim/ar-auth --filter=@authrim/ar-token --filter=@authrim/ar-management --filter=@authrim/ar-lib-core --filter=@authrim/ar-lib-logging --filter=@authrim/ar-lib-policy --filter=@authrim/ar-saml -- --coverage",
    "test:multi-tenant-conformance": "pnpm exec vitest run test/integration/tenant-d1-runtime-smoke.test.ts test/integration/tenant-system/oidc-cross-tenant-challenge.test.ts packages/ar-auth/src/__tests__/tenant-d1-runtime-boundary.test.ts packages/ar-management/src/__tests__/admin-route-access.test.ts packages/ar-management/src/__tests__/machine-access-router.test.ts packages/ar-management/src/__tests__/pii-partitions.test.ts packages/ar-management/src/__tests__/admin.test.ts packages/ar-management/src/__tests__/admin-users-totp.test.ts packages/ar-management/src/__tests__/policy.test.ts packages/ar-management/src/__tests__/user-import-jobs.test.ts packages/ar-saml/src/common/__tests__/tenant.test.ts packages/ar-saml/src/common/__tests__/saml-signing-keys.test.ts packages/ar-saml/src/sp/__tests__/conditions.test.ts packages/ar-saml/src/__tests__/saml-integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:lighthouse": "lhci autorun",
    "test:lighthouse:collect": "lhci collect",
    "test:lighthouse:assert": "lhci assert",
    "asvs:check": "node scripts/asvs-check.mjs",
    "asvs:check:enforce": "node scripts/asvs-check.mjs --enforce-no-gaps",
    "openapi:validate": "node scripts/validate-openapi.mjs",
    "openapi:routes": "node scripts/openapi-route-inventory.mjs",
    "openapi:backfill-routes": "node scripts/backfill-openapi-route-stubs.mjs",
    "openapi:refine-docs": "node scripts/refine-openapi-docs.mjs",
    "docs:api": "node scripts/build-api-docs.mjs",
    "docs:api:sync-website": "node scripts/sync-api-docs-to-website.mjs",
    "conformance:run": "tsx conformance/scripts/run-conformance.ts",
    "conformance:basic": "tsx conformance/scripts/run-conformance.ts --plan basic-op",
    "conformance:config": "tsx conformance/scripts/run-conformance.ts --plan config-op",
    "conformance:dynamic": "tsx conformance/scripts/run-conformance.ts --plan dynamic-op",
    "conformance:fapi2": "tsx conformance/scripts/run-conformance.ts --plan fapi-2",
    "conformance:all": "tsx conformance/scripts/run-conformance.ts --plan all",
    "conformance:details": "tsx conformance/scripts/get-test-details.ts",
    "conformance:errors": "tsx conformance/scripts/get-test-details.ts --failed-only",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"packages/**/*.ts\"",
    "format:check": "prettier --check \"packages/**/*.ts\"",
    "security:audit": "pnpm --package=pnpm@11.4.0 dlx pnpm --pm-on-fail=ignore audit --audit-level=high",
    "clean": "turbo run clean && rm -rf node_modules",
    "generate-keys": "tsx scripts/generate-keys.ts",
    "migrate:create": "tsx scripts/create-migration.ts",
    "migrate:info": "echo '\n📋 Migration Commands:\n\n  migrate:create <name>  - Create a new migration file\n\nFresh installs are applied by @authrim/setup from the baseline files in migrations/.\nFor manual local checks, apply migrations/[0-9][0-9][0-9]_*.sql in lexical order.\n'",
    "setup": "tsx packages/setup/src/index.ts",
    "setup:init": "tsx packages/setup/src/index.ts init",
    "setup:manage": "tsx packages/setup/src/index.ts manage",
    "setup:deploy": "tsx packages/setup/src/index.ts deploy",
    "setup:status": "tsx packages/setup/src/index.ts status",
    "setup:info": "tsx packages/setup/src/index.ts info",
    "setup:validate-generated-env": "tsx test/environment-validation/validate-generated-env.ts",
    "setup:smoke-generated-api": "tsx test/environment-validation/smoke-generated-api.ts",
    "setup:smoke-generated-admin-api": "tsx test/environment-validation/smoke-generated-admin-api.ts",
    "setup:smoke-generated-auth-flow": "tsx test/environment-validation/smoke-generated-auth-flow.ts",
    "setup:smoke-generated-approvals": "tsx test/environment-validation/smoke-generated-approvals.ts",
    "setup:smoke-generated-server-surfaces": "tsx test/environment-validation/smoke-generated-server-surfaces.ts",
    "admin-ui:issue-session": "tsx tools/admin-ui-session/issue-session.ts",
    "test:remote:logging": "tsx test/remote-logging/smoke-remote-logging-output.ts",
    "setup:load-generated-live-safe": "tsx test/environment-validation/load-generated-live-safe.ts",
    "setup:local-capacity": "tsx test/environment-validation/local-capacity.ts",
    "setup:local-user-scale": "tsx test/environment-validation/local-user-scale.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "openid-connect",
    "oidc",
    "oauth2",
    "cloudflare-workers",
    "identity-provider",
    "authentication"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "hono": "4.12.29",
    "jose": "^6.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cloudflare/workers-types": "^4.20251121.0",
    "@esbuild/win32-x64": "^0.25.12",
    "@eslint/js": "^9.39.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.19.25",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^4.1.8",
    "axe-core": "^4.11.0",
    "eslint": "^9.39.1",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "turbo": "^2.9.17",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.110.0",
    "yaml": "2.8.3"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.25.12"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.15.2",
      "ajv@<6.14.0": "6.15.0",
      "brace-expansion@<1.1.13": "1.1.15",
      "yaml@>=1.0.0 <1.10.3": "1.10.3",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "vite@7.3.5>yaml": "2.8.3",
      "postcss": ">=8.5.15",
      "ip-address": ">=10.2.0",
      "ws": ">=8.21.0",
      "uuid": ">=11.1.1",
      "lodash": ">=4.18.0",
      "lodash-es": ">=4.18.0",
      "tmp": ">=0.2.6",
      "cookie": ">=0.7.0",
      "basic-ftp": ">=5.3.1",
      "path-to-regexp@<0.1.13": "0.1.13",
      "picomatch": ">=4.0.4",
      "undici": ">=8.5.0",
      "defu": ">=6.1.5",
      "vite": ">=7.3.2",
      "@sveltejs/kit": ">=2.57.1",
      "rollup": ">=4.59.0",
      "hono": "4.12.29",
      "@hono/node-server": "^1.19.13",
      "tar": "^7.5.14",
      "devalue": "^5.8.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "@xmldom/xmldom": "^0.8.13",
      "esbuild": "0.28.1"
    }
  }
}
