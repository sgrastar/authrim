{
	"name": "@authrim/ar-admin-console",
	"private": true,
	"version": "0.4.2",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:stories": "vitest run --project storybook",
		"test:coverage": "vitest run --project unit --coverage",
		"lint": "eslint . && node scripts/check-route-styles.mjs && node scripts/check-raw-colors.mjs && node scripts/check-type-scale.mjs",
		"check:dev-mock-guard": "node scripts/check-dev-mock-guard.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"deploy:preview": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-ui.ts --env=\"$DEPLOY_ENV\" --package=ar-admin-ui --phase=final",
		"deploy:production": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-ui.ts --env=\"$DEPLOY_ENV\" --package=ar-admin-ui --phase=final"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@storybook/addon-a11y": "^10.6.0",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/addon-svelte-csf": "^5.1.3",
		"@storybook/addon-vitest": "^10.6.0",
		"@storybook/sveltekit": "^10.6.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@vitest/browser": "^4.1.11",
		"@vitest/browser-playwright": "^4.1.11",
		"eslint": "^9.39.1",
		"eslint-plugin-storybook": "^10.6.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^15.15.0",
		"jsdom": "^27.2.0",
		"playwright": "^1.56.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"remark-gfm": "^4.0.1",
		"storybook": "^10.6.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^7.3.5",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@authrim/ar-lib-core": "workspace:*",
		"@authrim/ar-lib-field-mapping": "workspace:*",
		"@simplewebauthn/browser": "^13.2.2"
	}
}
