{
	"name": "@authrim/ar-admin-ui",
	"private": true,
	"version": "0.4.0",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint .",
		"check:i18n": "node scripts/check-i18n-usage.mjs",
		"check:i18n:strict": "node scripts/check-i18n-usage.mjs --strict",
		"check:dev-mock-guard": "node scripts/check-dev-mock-guard.mjs",
		"check:hardcoded-english": "node scripts/check-svelte-literals.mjs",
		"check:hardcoded-english:strict": "node scripts/check-svelte-literals.mjs --strict",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"deploy:preview": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-ui.ts --env=\"$DEPLOY_ENV\" --package=ar-admin-ui --phase=final",
		"deploy:production": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-ui.ts --env=\"$DEPLOY_ENV\" --package=ar-admin-ui --phase=final",
		"typesafe-i18n": "typesafe-i18n"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@iconify-json/heroicons": "^1.2.3",
		"@iconify-json/ph": "^1.2.2",
		"@melt-ui/pp": "^0.3.2",
		"@melt-ui/svelte": "^0.86.6",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "5.2.0-next.3",
		"@testing-library/user-event": "^14.6.1",
		"@types/d3": "^7.4.3",
		"@types/geojson": "^7946.0.16",
		"@unocss/reset": "^66.5.9",
		"@vitest/ui": "^4.1.8",
		"eslint": "^9.39.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^15.15.0",
		"jsdom": "^27.2.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.3.4",
		"typesafe-i18n": "^5.26.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"unocss": "^66.5.9",
		"vite": "^7.3.5",
		"vitest": "^4.1.8",
		"yaml": "2.8.3"
	},
	"dependencies": {
		"@authrim/ar-lib-core": "workspace:*",
		"@simplewebauthn/browser": "^13.2.2",
		"@xyflow/svelte": "^1.5.0",
		"d3": "^7.9.0",
		"monaco-editor": "^0.55.1",
		"qrcode": "^1.5.4"
	}
}
