{
  "name": "@authrim/ar-async",
  "version": "0.5.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-api.ts --env=\"$DEPLOY_ENV\" --component=ar-async --mode=auto --concurrency=1",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --pass-on-unpruned-suppressions",
    "lint:prune-suppressions": "eslint src --prune-suppressions",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@authrim/ar-lib-core": "workspace:*",
    "hono": "4.13.12",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@vitest/ui": "^4.1.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0",
    "yaml": "2.9.1"
  }
}
