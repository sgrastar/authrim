{
  "schemaVersion": 1,
  "packageName": "@authrim/ar-auth",
  "worker": "ar-auth",
  "lookupBlindIndex": true,
  "requiredDataRoles": ["tenant_core/default", "tenant_core/users", "tenant_pii", "lookup"],
  "bindings": [
    { "name": "DB", "kind": "d1", "required": true, "dataRole": "tenant_core/default" },
    {
      "name": "TDB_SHARED_CORE",
      "kind": "d1",
      "required": true,
      "dataRole": "tenant_core/default"
    },
    { "name": "DB_PII", "kind": "d1", "required": true, "dataRole": "tenant_pii" },
    { "name": "DB_ADMIN", "kind": "d1", "required": true, "capability": "admin_login" },
    { "name": "LOOKUP_DB", "kind": "d1", "required": true, "dataRole": "lookup" },
    { "name": "CLIENTS_CACHE", "kind": "kv_namespace", "required": true },
    { "name": "SETTINGS", "kind": "kv_namespace", "required": true },
    { "name": "USER_CACHE", "kind": "kv_namespace", "required": true },
    { "name": "CONSENT_CACHE", "kind": "kv_namespace", "required": true },
    { "name": "AUTHRIM_CONFIG", "kind": "kv_namespace", "required": true },
    { "name": "TENANT_RUNTIME_REGISTRY", "kind": "kv_namespace", "required": true },
    { "name": "KEY_MANAGER", "kind": "durable_object_namespace", "required": true },
    { "name": "SESSION_STORE", "kind": "durable_object_namespace", "required": true },
    {
      "name": "SESSION_REVOCATION_STORE",
      "kind": "durable_object_namespace",
      "required": true
    },
    { "name": "AUTH_CODE_STORE", "kind": "durable_object_namespace", "required": true },
    { "name": "CHALLENGE_STORE", "kind": "durable_object_namespace", "required": true },
    { "name": "RATE_LIMITER", "kind": "durable_object_namespace", "required": true },
    { "name": "PAR_REQUEST_STORE", "kind": "durable_object_namespace", "required": true },
    { "name": "FLOW_STATE_STORE", "kind": "durable_object_namespace", "required": true },
    { "name": "DIRECTORY_CONNECTOR_RELAY", "kind": "durable_object_namespace", "required": true },
    { "name": "PUBLIC_ASSETS", "kind": "r2_bucket", "required": false },
    { "name": "AVATARS", "kind": "r2_bucket", "required": false },
    { "name": "DIAGNOSTIC_LOGS", "kind": "r2_bucket", "required": false },
    { "name": "AUDIT_ARCHIVE", "kind": "r2_bucket", "required": false },
    { "name": "AUDIT_QUEUE", "kind": "queue", "required": false },
    { "name": "LOGGING_DELIVERY_CRITICAL_QUEUE", "kind": "queue", "required": false },
    { "name": "LOGGING_DELIVERY_QUEUE", "kind": "queue", "required": false },
    { "name": "LOGGING_DELIVERY_BULK_QUEUE", "kind": "queue", "required": false },
    { "name": "EXTERNAL_IDP", "kind": "service", "required": true },
    {
      "name": "ACCOUNT_PROVISIONER",
      "kind": "service",
      "required": true,
      "capability": "account.provision"
    },
    {
      "name": "PLUGIN_RUNNER",
      "kind": "service",
      "required": true,
      "capability": "plugin_hooks.invoke"
    },
    {
      "name": "TENANT_DATABASE_HYPERDRIVE",
      "kind": "hyperdrive",
      "required": false,
      "capability": "tenant_database_profiles"
    },
    { "name": "CONTROL_SMOKE_VERSION", "kind": "version_metadata", "required": true }
  ],
  "secrets": [
    { "name": "PRIVATE_KEY_PEM", "capability": "legacy_signing.private", "required": true },
    { "name": "PUBLIC_JWK_JSON", "capability": "legacy_signing.public", "required": true },
    {
      "name": "RP_TOKEN_ENCRYPTION_KEY",
      "capability": "external_idp_tokens.decrypt",
      "required": true
    },
    { "name": "PII_ENCRYPTION_KEY", "capability": "tenant_pii.encrypt_decrypt", "required": true },
    { "name": "OTP_HMAC_SECRET", "capability": "otp.verify", "required": true },
    { "name": "FLOW_RUNTIME_HMAC_SECRET", "capability": "flow_runtime.verify", "required": true },
    {
      "name": "NOTIFICATION_PAYLOAD_ENCRYPTION_PUBLIC_JWKS",
      "capability": "notification_payload.encrypt",
      "required": true
    },
    {
      "name": "NOTIFICATION_INTENT_HMAC_KEY",
      "capability": "notification_intent.idempotency",
      "required": true
    },
    {
      "name": "TENANT_RUNTIME_REGISTRY_VERIFYING_PUBLIC_JWKS",
      "capability": "runtime_registry.verify",
      "required": true
    },
    {
      "name": "LOOKUP_HMAC_KEY_SLOT_A",
      "capability": "lookup_blind_index",
      "required": true
    },
    {
      "name": "LOOKUP_HMAC_KEY_SLOT_B",
      "capability": "lookup_blind_index",
      "required": false
    },
    {
      "name": "CONTROL_SMOKE_VERIFYING_PUBLIC_JWKS",
      "capability": "control_smoke.verify",
      "required": true
    }
  ]
}
