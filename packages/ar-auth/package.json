{
  "name": "@authrim/ar-auth",
  "version": "0.3.3",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./flow-engine": "./src/flow-engine/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.toml 2>/dev/null || wrangler dev",
    "deploy": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-api.ts --env=\"$DEPLOY_ENV\" --component=ar-auth --mode=auto --concurrency=1",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'op-auth: lint skipped'",
    "test": "pnpm exec vitest run",
    "test:unit": "pnpm exec vitest run",
    "test:integration": "pnpm exec vitest run --config vitest.integration.config.ts",
    "test:passkey": "pnpm exec vitest run --config vitest.passkey.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@authrim/ar-agent-access": "workspace:*",
    "@authrim/ar-lib-core": "workspace:*",
    "@authrim/ar-lib-plugin": "workspace:*",
    "@simplewebauthn/server": "^13.2.2",
    "hono": "4.12.29",
    "jose": "^6.1.2",
    "resend": "^6.5.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251121.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.110.0",
    "yaml": "2.8.3"
  }
}
