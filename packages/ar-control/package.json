{
  "name": "@authrim/ar-control",
  "version": "0.5.1",
  "type": "module",
  "private": true,
  "exports": {
    "./bootstrap-handoff": {
      "types": "./src/bootstrap-handoff.ts",
      "default": "./src/bootstrap-handoff.ts"
    },
    "./worker-binding-repository": {
      "types": "./src/worker-binding-repository.ts",
      "default": "./src/worker-binding-repository.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-api.ts --env=\"$DEPLOY_ENV\" --component=ar-control --mode=auto --concurrency=1",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@authrim/ar-lib-core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^22.19.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
