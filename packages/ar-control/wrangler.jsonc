{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ar-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "build": {
    "command": "node ../../scripts/guard-managed-worker-deploy.mjs",
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
}
