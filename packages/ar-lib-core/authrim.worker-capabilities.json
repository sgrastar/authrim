{
  "schemaVersion": 1,
  "packageName": "@authrim/ar-lib-core",
  "worker": "ar-lib-core",
  "lookupBlindIndex": true,
  "requiredDataRoles": ["tenant_core/default", "tenant_core/users", "tenant_pii", "lookup"],
  "bindings": [
    { "name": "DB", "kind": "d1", "required": true, "dataRole": "tenant_core/default" },
    { "name": "DB_PII", "kind": "d1", "required": true, "dataRole": "tenant_pii" },
    { "name": "LOOKUP_DB", "kind": "d1", "required": true, "dataRole": "lookup" },
    {
      "name": "AUTHRIM_CONFIG",
      "kind": "kv_namespace",
      "required": true,
      "capability": "durable_object_config.read"
    },
    {
      "name": "TENANT_RUNTIME_REGISTRY",
      "kind": "kv_namespace",
      "required": true
    },
    { "name": "SESSION_STORE", "kind": "durable_object_namespace", "required": true },
    {
      "name": "SESSION_REVOCATION_STORE",
      "kind": "durable_object_namespace",
      "required": true
    },
    { "name": "SESSION_CLIENT_STORE", "kind": "durable_object_namespace", "required": true },
    { "name": "KEY_MANAGER", "kind": "durable_object_namespace", "required": true },
    { "name": "AUTH_CODE_STORE", "kind": "durable_object_namespace", "required": true },
    { "name": "REFRESH_TOKEN_ROTATOR", "kind": "durable_object_namespace", "required": true },
    { "name": "CHALLENGE_STORE", "kind": "durable_object_namespace", "required": true },
    { "name": "RATE_LIMITER", "kind": "durable_object_namespace", "required": true },
    { "name": "PAR_REQUEST_STORE", "kind": "durable_object_namespace", "required": true },
    { "name": "DPOP_JTI_STORE", "kind": "durable_object_namespace", "required": true },
    { "name": "DEVICE_CODE_STORE", "kind": "durable_object_namespace", "required": true },
    { "name": "CIBA_REQUEST_STORE", "kind": "durable_object_namespace", "required": true },
    { "name": "TOKEN_REVOCATION_STORE", "kind": "durable_object_namespace", "required": true },
    { "name": "VERSION_MANAGER", "kind": "durable_object_namespace", "required": true },
    { "name": "SAML_REQUEST_STORE", "kind": "durable_object_namespace", "required": true },
    {
      "name": "SAML_AGGREGATE_METADATA_STORE",
      "kind": "durable_object_namespace",
      "required": true
    },
    { "name": "PERMISSION_CHANGE_HUB", "kind": "durable_object_namespace", "required": true },
    { "name": "FLOW_STATE_STORE", "kind": "durable_object_namespace", "required": true },
    {
      "name": "DEVICE_SECRET_ROUTE_STORE",
      "kind": "durable_object_namespace",
      "required": true
    },
    { "name": "CONTROL_SMOKE_VERSION", "kind": "version_metadata", "required": true }
  ],
  "secrets": [
    {
      "name": "TENANT_RUNTIME_REGISTRY_VERIFYING_PUBLIC_JWKS",
      "capability": "runtime_registry.verify",
      "required": true
    },
    {
      "name": "LOOKUP_HMAC_KEY_SLOT_A",
      "capability": "lookup_blind_index",
      "required": true
    },
    {
      "name": "LOOKUP_HMAC_KEY_SLOT_B",
      "capability": "lookup_blind_index",
      "required": false
    },
    {
      "name": "OBJECT_ENCRYPTION_ROOT_KEY",
      "capability": "object_encryption.encrypt_decrypt",
      "required": true
    },
    {
      "name": "CONTROL_SMOKE_VERIFYING_PUBLIC_JWKS",
      "capability": "control_smoke.verify",
      "required": true
    }
  ]
}
