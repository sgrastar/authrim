{
  "name": "@authrim/ar-lib-core",
  "version": "0.3.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./utils/*": {
      "import": "./dist/utils/*.js",
      "default": "./src/utils/*.ts"
    },
    "./webauthn/*": {
      "import": "./dist/webauthn/*.js",
      "default": "./src/webauthn/*.ts"
    },
    "./types/*": {
      "import": "./dist/types/*.js",
      "default": "./src/types/*.ts"
    },
    "./middleware/*": {
      "import": "./dist/middleware/*.js",
      "default": "./src/middleware/*.ts"
    },
    "./storage/*": {
      "import": "./dist/storage/*.js",
      "default": "./src/storage/*.ts"
    },
    "./durable-objects/*": {
      "import": "./dist/durable-objects/*.js",
      "default": "./src/durable-objects/*.ts"
    },
    "./services/*": {
      "import": "./dist/services/*.js",
      "default": "./src/services/*.ts"
    },
    "./notifications": {
      "import": "./dist/notifications/index.js",
      "default": "./src/notifications/index.ts"
    },
    "./constants": {
      "import": "./dist/constants.js",
      "default": "./src/constants.ts"
    },
    "./test/setup": "./src/test/setup.ts",
    "./test/fixtures": "./src/test/fixtures.ts"
  },
  "scripts": {
    "build": "tsc",
    "deploy": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-api.ts --env=\"$DEPLOY_ENV\" --component=ar-lib-core --mode=auto --concurrency=1",
    "dev": "wrangler dev --config wrangler.dev.toml 2>/dev/null || wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Shared package: lint skipped'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run -c vitest.property.config.ts",
    "test:all": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@authrim/ar-lib-field-mapping": "workspace:*",
    "@authrim/ar-lib-logging": "workspace:*",
    "hono": "4.12.29",
    "jose": "^6.1.2",
    "mysql2": "^3.15.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251121.0",
    "@types/node": "^20.19.25",
    "@types/pg": "^8.15.6",
    "fast-check": "^4.5.3",
    "typescript": "^5.9.3",
    "yaml": "2.8.3"
  }
}
