{
  "name": "@authrim/ar-lib-field-mapping",
  "version": "0.5.1",
  "type": "module",
  "exports": {
    "./contract": {
      "import": "./dist/contract.js",
      "types": "./dist/contract.d.ts",
      "default": "./src/contract.ts"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "types": "./dist/runtime.d.ts",
      "default": "./src/runtime.ts"
    },
    "./authoring": {
      "import": "./dist/authoring.js",
      "types": "./dist/authoring.d.ts",
      "default": "./src/authoring.ts"
    },
    "./experimental": {
      "import": "./dist/experimental.js",
      "types": "./dist/experimental.d.ts",
      "default": "./src/experimental.ts"
    },
    "./test-support": {
      "import": "./dist/test-support/index.js",
      "types": "./dist/test-support/index.d.ts",
      "default": "./src/test-support/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --pass-on-unpruned-suppressions",
    "lint:prune-suppressions": "eslint src --prune-suppressions",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^20.19.25",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "yaml": "2.9.1"
  }
}
