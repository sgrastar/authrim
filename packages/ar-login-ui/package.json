{
	"name": "@authrim/ar-login-ui",
	"private": true,
	"version": "0.5.1",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"deploy:preview": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-ui.ts --env=\"$DEPLOY_ENV\" --package=ar-login-ui --phase=final",
		"deploy:production": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-ui.ts --env=\"$DEPLOY_ENV\" --package=ar-login-ui --phase=final",
		"storybook": "storybook dev -p 6007",
		"build-storybook": "storybook build",
		"test:stories": "vitest run --config vitest.storybook.config.ts",
		"typesafe-i18n": "typesafe-i18n"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@iconify-json/ph": "^1.2.2",
		"@melt-ui/pp": "^0.3.2",
		"@melt-ui/svelte": "^0.86.6",
		"@storybook/addon-a11y": "^10.6.3",
		"@storybook/addon-docs": "^10.6.3",
		"@storybook/addon-svelte-csf": "^5.1.3",
		"@storybook/addon-vitest": "^10.6.3",
		"@storybook/sveltekit": "^10.6.3",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/qrcode": "^1.5.6",
		"@unocss/reset": "^66.11.0",
		"@vitest/browser": "^4.1.12",
		"@vitest/browser-playwright": "^4.1.12",
		"@vitest/ui": "^4.1.12",
		"eslint": "^9.39.1",
		"eslint-plugin-storybook": "^10.6.3",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^15.15.0",
		"jsdom": "^27.2.0",
		"playwright": "^1.56.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"remark-gfm": "^4.0.1",
		"storybook": "^10.6.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.5",
		"typesafe-i18n": "^5.26.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"unocss": "^66.5.9",
		"vite": "^8.3.5",
		"vitest": "^4.1.12",
		"yaml": "2.9.1"
	},
	"dependencies": {
		"@authrim/ar-lib-core": "workspace:*",
		"@authrim/core": "^0.2.1",
		"@simplewebauthn/browser": "^14.0.0",
		"qrcode": "^1.5.4"
	}
}
