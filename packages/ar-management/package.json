{
  "name": "@authrim/ar-management",
  "version": "0.4.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.toml 2>/dev/null || wrangler dev",
    "deploy": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-api.ts --env=\"$DEPLOY_ENV\" --component=ar-management --mode=auto --concurrency=1",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'op-management: lint skipped'",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@authrim/ar-agent-access": "workspace:*",
    "@authrim/ar-auth": "workspace:^",
    "@authrim/ar-lib-core": "workspace:*",
    "@authrim/ar-lib-field-mapping": "workspace:*",
    "@authrim/ar-lib-logging": "workspace:*",
    "@authrim/ar-lib-plugin": "workspace:*",
    "@authrim/ar-lib-policy": "workspace:*",
    "@authrim/ar-lib-scim": "workspace:*",
    "@simplewebauthn/server": "^13.2.2",
    "hono": "4.13.2",
    "jose": "^6.2.9",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251121.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.110.0",
    "yaml": "2.8.3"
  }
}
