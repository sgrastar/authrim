{
  "schemaVersion": 1,
  "packageName": "@authrim/ar-plugin-runner",
  "worker": "ar-plugin-runner",
  "requiredDataRoles": ["plugin_runner", "tenant_core/default", "tenant_core/users"],
  "bindings": [
    {
      "name": "PLATFORM_NOTIFICATION_DB",
      "kind": "d1",
      "required": true,
      "capability": "notification_intent.platform"
    },
    {
      "name": "PLUGIN_RUNNER_DB",
      "kind": "d1",
      "required": true,
      "dataRole": "plugin_runner",
      "capability": "plugin_runner.state"
    },
    {
      "name": "TENANT_RUNTIME_REGISTRY",
      "kind": "kv_namespace",
      "required": true,
      "capability": "runtime_registry.read"
    },
    {
      "name": "PLUGIN_LOADER",
      "kind": "worker_loader",
      "required": false,
      "capability": "plugin_dynamic_worker.invoke"
    },
    {
      "name": "PLUGIN_BUNDLES",
      "kind": "r2_bucket",
      "required": false,
      "capability": "plugin_dynamic_worker.code.read"
    },
    {
      "name": "CONTROL",
      "kind": "service",
      "required": true,
      "capability": "r2_metrics.report"
    },
    {
      "name": "EMAIL",
      "kind": "send_email",
      "required": false,
      "capability": "notification_provider.cloudflare.send"
    },
    {
      "name": "CONTROL_SMOKE_VERSION",
      "kind": "version_metadata",
      "required": true,
      "capability": "control_smoke.respond"
    }
  ],
  "dynamicBindings": [
    {
      "prefix": "PRES_D1_",
      "kind": "d1",
      "suffixFormat": "uppercase_hex_24",
      "capability": "plugin_dynamic_worker.resource.d1"
    },
    {
      "prefix": "PRES_KV_",
      "kind": "kv_namespace",
      "suffixFormat": "uppercase_hex_24",
      "capability": "plugin_dynamic_worker.resource.kv"
    },
    {
      "prefix": "PRES_R2_",
      "kind": "r2_bucket",
      "suffixFormat": "uppercase_hex_24",
      "capability": "plugin_dynamic_worker.resource.r2"
    }
  ],
  "secrets": [
    {
      "name": "TENANT_RUNTIME_REGISTRY_VERIFYING_PUBLIC_JWKS",
      "capability": "runtime_registry.verify",
      "required": true
    },
    {
      "name": "PLUGIN_ENCRYPTION_KEY",
      "capability": "plugin_config.decrypt",
      "required": true
    },
    {
      "name": "PLUGIN_MUTATION_HMAC_KEY",
      "capability": "plugin_account_metadata.idempotency",
      "required": true
    },
    {
      "name": "NOTIFICATION_PAYLOAD_DECRYPTION_JWK_SLOT_A",
      "capability": "notification_payload.decrypt",
      "required": true
    },
    {
      "name": "NOTIFICATION_PAYLOAD_DECRYPTION_JWK_SLOT_B",
      "capability": "notification_payload.decrypt_previous",
      "required": false
    },
    {
      "name": "CONTROL_SMOKE_VERIFYING_PUBLIC_JWKS",
      "capability": "control_smoke.verify",
      "required": true
    }
  ]
}
