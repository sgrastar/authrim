{
  "name": "@authrim/ar-plugin-runner",
  "version": "0.5.1",
  "type": "module",
  "private": true,
  "scripts": {
    "deploy": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-api.ts --env=\"$DEPLOY_ENV\" --component=ar-plugin-runner --mode=auto --concurrency=1",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@authrim/ar-lib-core": "workspace:*",
    "@authrim/ar-lib-plugin": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^22.19.7",
    "jose": "^6.2.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
