{
  "schemaVersion": 1,
  "packageName": "@authrim/ar-policy",
  "worker": "ar-policy",
  "lookupBlindIndex": true,
  "requiredDataRoles": ["tenant_core/default", "tenant_core/users", "lookup"],
  "bindings": [
    {
      "name": "SETTINGS",
      "kind": "kv_namespace",
      "required": true,
      "capability": "settings.read"
    },
    {
      "name": "LOOKUP_DB",
      "kind": "d1",
      "required": true,
      "dataRole": "lookup"
    },
    {
      "name": "REBAC_CACHE",
      "kind": "kv_namespace",
      "required": true,
      "capability": "policy_cache.read_write"
    },
    {
      "name": "AUTHRIM_CONFIG",
      "kind": "kv_namespace",
      "required": true,
      "capability": "policy_config.read"
    },
    {
      "name": "TENANT_RUNTIME_REGISTRY",
      "kind": "kv_namespace",
      "required": true,
      "capability": "runtime_registry.read"
    },
    {
      "name": "RATE_LIMITER",
      "kind": "durable_object_namespace",
      "required": true
    },
    {
      "name": "PERMISSION_CHANGE_HUB",
      "kind": "durable_object_namespace",
      "required": true,
      "capability": "permission_changes.publish"
    },
    {
      "name": "KEY_MANAGER",
      "kind": "durable_object_namespace",
      "required": true
    },
    {
      "name": "DPOP_JTI_STORE",
      "kind": "durable_object_namespace",
      "required": true
    },
    {
      "name": "TOKEN_REVOCATION_STORE",
      "kind": "durable_object_namespace",
      "required": true
    },
    {
      "name": "PLUGIN_RUNNER",
      "kind": "service",
      "required": true,
      "capability": "plugin_hooks.invoke"
    },
    {
      "name": "TENANT_DATABASE_HYPERDRIVE",
      "kind": "hyperdrive",
      "required": false,
      "capability": "tenant_database_profiles"
    },
    {
      "name": "CONTROL_SMOKE_VERSION",
      "kind": "version_metadata",
      "required": true
    },
    {
      "name": "LOG_ARCHIVE_WRITER",
      "kind": "service",
      "required": false,
      "capability": "logging.archive.write"
    }
  ],
  "secrets": [
    {
      "name": "PUBLIC_JWK_JSON",
      "capability": "legacy_signing.public",
      "required": true
    },
    {
      "name": "TENANT_RUNTIME_REGISTRY_VERIFYING_PUBLIC_JWKS",
      "capability": "runtime_registry.verify",
      "required": true
    },
    {
      "name": "LOOKUP_HMAC_KEY_SLOT_A",
      "capability": "lookup_blind_index",
      "required": true
    },
    {
      "name": "LOOKUP_HMAC_KEY_SLOT_B",
      "capability": "lookup_blind_index",
      "required": false
    },
    {
      "name": "CONTROL_SMOKE_VERIFYING_PUBLIC_JWKS",
      "capability": "control_smoke.verify",
      "required": true
    },
    {
      "name": "OBJECT_ENCRYPTION_ROOT_KEY",
      "required": true,
      "capability": "logging.archive.encrypt"
    },
    {
      "name": "LOG_ARCHIVE_CONTENT_HMAC_KEY",
      "required": false,
      "capability": "logging.archive.encrypt"
    },
    {
      "name": "LOG_ARCHIVE_ROOT_KEYRING",
      "required": false,
      "capability": "logging.archive.encrypt"
    }
  ]
}
