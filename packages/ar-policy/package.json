{
  "name": "@authrim/ar-policy",
  "version": "0.3.3",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.toml 2>/dev/null || wrangler dev",
    "deploy": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-api.ts --env=\"$DEPLOY_ENV\" --component=ar-policy --mode=auto --concurrency=1",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'policy-service: lint skipped'",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@authrim/ar-lib-core": "workspace:*",
    "@authrim/ar-lib-policy": "workspace:*",
    "hono": "4.12.29"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251121.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.110.0",
    "yaml": "2.8.3"
  }
}
