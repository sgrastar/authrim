{
  "name": "@authrim/ar-runtime-aws",
  "version": "0.5.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dsql:assess": "node dist/dsql-cli.mjs assess --root ../..",
    "dsql:probe": "node dist/dsql-cli.mjs probe",
    "build": "node scripts/build.mjs",
    "restore:offline": "node dist/restore-cli.mjs",
    "collect:supplement": "node dist/collector-cli.mjs",
    "replication": "node dist/replication-cli.mjs",
    "package:replication-authority": "node scripts/build.mjs && node scripts/package-replication-authority.mjs",
    "package:lambda": "node scripts/build.mjs && node scripts/package-lambda.mjs",
    "package:browser-sp": "node scripts/build.mjs && node scripts/package-browser-sp.mjs",
    "package:db-bootstrap": "node scripts/build.mjs && node scripts/package-db-bootstrap.mjs",
    "rehearsal:fixture": "node dist/synthetic-backup-cli.mjs",
    "setup:plan": "node scripts/setup-plan.mjs",
    "setup:check": "node scripts/aws-preflight.mjs",
    "setup:execute": "node scripts/setup-execute.mjs",
    "setup:dsql": "node scripts/setup-dsql.mjs",
    "test:setup-dsql": "node --test scripts/setup-dsql.test.mjs",
    "test:setup-executor": "node --test scripts/setup-executor.test.mjs scripts/setup-artifacts.test.mjs scripts/setup-plan-adoption.test.mjs",
    "test:setup-plan": "node --test scripts/setup-plan.test.mjs",
    "test:setup-preflight": "node --test scripts/aws-preflight.test.mjs",
    "test:packaging": "node --test scripts/package-serving.test.mjs",
    "test:browser-deployment": "node --test scripts/browser-deployment.test.mjs scripts/auth-state-deployment.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false && node --test scripts/setup-plan.test.mjs scripts/aws-preflight.test.mjs scripts/package-serving.test.mjs scripts/browser-deployment.test.mjs scripts/auth-state-deployment.test.mjs scripts/setup-executor.test.mjs scripts/setup-artifacts.test.mjs scripts/setup-plan-adoption.test.mjs scripts/setup-dsql.test.mjs scripts/setup-config.test.mjs scripts/replication-execute.test.mjs scripts/replication-authority-package.test.mjs scripts/replication-authority-deployment.test.mjs",
    "lint": "eslint src --pass-on-unpruned-suppressions"
  },
  "dependencies": {
    "@authrim/ar-auth": "workspace:*",
    "@authrim/ar-lib-core": "workspace:*",
    "@authrim/ar-saml": "workspace:*",
    "@aws-sdk/client-dynamodb": "3.1152.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/client-secrets-manager": "3.1152.0",
    "@aws-sdk/client-sts": "3.1152.0",
    "@aws-sdk/credential-providers": "3.1152.0",
    "@aws-sdk/dsql-signer": "3.1152.0",
    "hono": "4.13.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
