{
  "schemaVersion": 1,
  "packageName": "@authrim/ar-saml",
  "worker": "ar-saml",
  "requiredDataRoles": ["tenant_core/default", "tenant_core/users", "tenant_pii"],
  "bindings": [
    { "name": "DB", "kind": "d1", "required": true, "capability": "audit.event" },
    { "name": "DB_PII", "kind": "d1", "required": true, "capability": "audit.pii" },
    { "name": "DB_ADMIN", "kind": "d1", "required": true, "capability": "saml_metadata" },
    { "name": "SETTINGS", "kind": "kv_namespace", "required": true },
    { "name": "AUTHRIM_CONFIG", "kind": "kv_namespace", "required": true },
    { "name": "STATE_STORE", "kind": "kv_namespace", "required": true },
    {
      "name": "PLUGIN_RUNNER",
      "kind": "service",
      "required": true,
      "capability": "plugin_hooks.invoke"
    },
    { "name": "TENANT_RUNTIME_REGISTRY", "kind": "kv_namespace", "required": true },
    { "name": "KEY_MANAGER", "kind": "durable_object_namespace", "required": true },
    { "name": "SAML_REQUEST_STORE", "kind": "durable_object_namespace", "required": true },
    {
      "name": "SAML_AGGREGATE_METADATA_STORE",
      "kind": "durable_object_namespace",
      "required": true
    },
    { "name": "SESSION_STORE", "kind": "durable_object_namespace", "required": true },
    {
      "name": "SESSION_REVOCATION_STORE",
      "kind": "durable_object_namespace",
      "required": true
    },
    { "name": "CHALLENGE_STORE", "kind": "durable_object_namespace", "required": true },
    { "name": "DIAGNOSTIC_LOGS", "kind": "r2_bucket", "required": false },
    { "name": "AUDIT_ARCHIVE", "kind": "r2_bucket", "required": false },
    { "name": "LOGGING_DELIVERY_CRITICAL_QUEUE", "kind": "queue", "required": false },
    { "name": "LOGGING_DELIVERY_QUEUE", "kind": "queue", "required": false },
    { "name": "LOGGING_DELIVERY_BULK_QUEUE", "kind": "queue", "required": false },
    { "name": "TENANT_DATABASE_HYPERDRIVE", "kind": "hyperdrive", "required": false },
    { "name": "CONTROL_SMOKE_VERSION", "kind": "version_metadata", "required": true }
  ],
  "secrets": [
    {
      "name": "TENANT_RUNTIME_REGISTRY_VERIFYING_PUBLIC_JWKS",
      "capability": "runtime_registry.verify",
      "required": true
    },
    {
      "name": "CONTROL_SMOKE_VERIFYING_PUBLIC_JWKS",
      "capability": "control_smoke.verify",
      "required": true
    }
  ]
}
