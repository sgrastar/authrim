{
  "name": "@authrim/ar-saml",
  "version": "0.5.1",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./idp-app": "./src/idp-app.ts",
    "./idp-readiness": "./src/idp-readiness.ts",
    "./src/*": "./src/*.ts",
    "./inbound-receiver": {
      "types": "./src/inbound-receiver.d.ts",
      "import": "./src/sp/acs.ts",
      "default": "./src/sp/acs.ts"
    },
    "./admin-providers": {
      "types": "./src/admin-providers.d.ts",
      "import": "./src/admin/providers.ts",
      "default": "./src/admin/providers.ts"
    },
    "./release-explain": {
      "types": "./src/release-explain.d.ts",
      "import": "./src/idp/explain-release.ts",
      "default": "./src/idp/explain-release.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-api.ts --env=\"$DEPLOY_ENV\" --component=ar-saml --mode=auto --concurrency=1",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --pass-on-unpruned-suppressions",
    "lint:prune-suppressions": "eslint src --prune-suppressions",
    "test": "vitest run --fileParallelism=false",
    "test:mutation": "mutator",
    "test:mutation:diff": "mutator --since origin/develop --include-test-changes",
    "test:mutation:stryker": "stryker run",
    "test:property": "vitest run -c vitest.property.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@authrim/ar-lib-core": "workspace:*",
    "@authrim/ar-lib-field-mapping": "workspace:*",
    "@xmldom/xmldom": "^0.8.15",
    "hono": "4.13.18",
    "jose": "^6.2.13",
    "pako": "^3.0.2",
    "saxes": "6.0.0",
    "xml-crypto": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@vitest/ui": "^4.1.12",
    "fast-check": "^4.5.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0",
    "yaml": "2.9.1"
  }
}
