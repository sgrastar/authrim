{
  "name": "@authrim/ar-saml",
  "version": "0.4.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-api.ts --env=\"$DEPLOY_ENV\" --component=ar-saml --mode=auto --concurrency=1",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'op-saml: lint skipped (uses root eslint config)'",
    "test": "vitest run --fileParallelism=false",
    "test:property": "vitest run -c vitest.property.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@authrim/ar-lib-core": "workspace:*",
    "@authrim/ar-lib-field-mapping": "workspace:*",
    "@xmldom/xmldom": "^0.8.13",
    "hono": "4.13.2",
    "jose": "^6.2.9",
    "pako": "^2.1.0",
    "xml-crypto": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251121.0",
    "@types/pako": "^2.0.4",
    "@vitest/ui": "^4.1.8",
    "fast-check": "^4.5.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.110.0",
    "yaml": "2.8.3"
  }
}
