{
  "name": "@authrim/ar-token",
  "version": "0.5.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.toml 2>/dev/null || wrangler dev",
    "deploy": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-api.ts --env=\"$DEPLOY_ENV\" --component=ar-token --mode=auto --concurrency=1",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --pass-on-unpruned-suppressions",
    "lint:prune-suppressions": "eslint src --prune-suppressions",
    "test": "pnpm exec vitest run --config vitest.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@authrim/ar-agent-access": "workspace:*",
    "@authrim/ar-lib-core": "workspace:*",
    "hono": "4.13.12",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  }
}
