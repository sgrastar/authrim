{
  "name": "@authrim/ar-vc",
  "version": "0.3.3",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.toml 2>/dev/null || wrangler dev",
    "deploy": "test -n \"$DEPLOY_ENV\" && pnpm --dir ../.. exec tsx scripts/deploy-api.ts --env=\"$DEPLOY_ENV\" --component=ar-vc --mode=auto --concurrency=1",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "pnpm exec vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@authrim/ar-lib-core": "workspace:*",
    "@authrim/ar-lib-field-mapping": "workspace:*",
    "hono": "4.12.29",
    "jose": "^6.1.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251121.0",
    "@eslint/js": "^9.22.0",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.110.0",
    "yaml": "2.8.3"
  }
}
