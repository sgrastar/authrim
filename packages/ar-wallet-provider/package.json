{
  "name": "@authrim/ar-wallet-provider",
  "version": "0.5.1",
  "type": "module",
  "private": true,
  "description": "Authrim-operated Keyring wallet provider: verifies Apple App Attest and signs wallet and key attestation JWTs",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --ext .ts",
    "test": "pnpm exec vitest run",
    "test:mutation": "mutator",
    "test:mutation:diff": "mutator --since origin/develop --include-test-changes",
    "clean": "rm -rf dist",
    "dev": "wrangler dev --env staging"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "@authrim/ar-lib-core": "workspace:*",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@eslint/js": "^9.22.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "jose": "^6.2.13",
    "@types/node": "^22.19.7"
  }
}
