{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authrim.com/schemas/control-plane/phase0c-performance-evidence.schema.json",
  "title": "Authrim Phase 0c performance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "executedAt",
    "commit",
    "environment",
    "sourceRegion",
    "scenarios",
    "invariants"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "runId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$"
    },
    "executedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "environment": { "const": "test" },
    "sourceRegion": { "$ref": "#/$defs/nonEmptyLabel" },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifierDiscovery", "totpFullLogin"],
      "properties": {
        "identifierDiscovery": { "$ref": "#/$defs/identifierScenario" },
        "totpFullLogin": { "$ref": "#/$defs/totpScenario" }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlWorkerHotPathCalls",
        "cloudflareRestHotPathCalls",
        "identifierMaxPhysicalLookupD1Reads",
        "accountRouteKvReads",
        "accountRouteKvWrites",
        "routeFailOpenCount"
      ],
      "properties": {
        "controlWorkerHotPathCalls": { "$ref": "#/$defs/count" },
        "cloudflareRestHotPathCalls": { "$ref": "#/$defs/count" },
        "identifierMaxPhysicalLookupD1Reads": { "$ref": "#/$defs/count" },
        "accountRouteKvReads": { "$ref": "#/$defs/count" },
        "accountRouteKvWrites": { "$ref": "#/$defs/count" },
        "routeFailOpenCount": { "$ref": "#/$defs/count" }
      }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "metric": { "type": "number", "minimum": 0 },
    "nonEmptyLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "coldSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latencyMs", "servedByRegion", "servedByPrimary"],
      "properties": {
        "latencyMs": { "$ref": "#/$defs/metric" },
        "servedByRegion": { "$ref": "#/$defs/nonEmptyLabel" },
        "servedByPrimary": { "type": "boolean" }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestOrIsolateP95Ms", "lookupD1QueryP95Ms", "primaryRecheckCount"],
      "properties": {
        "requestOrIsolateP95Ms": { "$ref": "#/$defs/metric" },
        "lookupD1QueryP95Ms": { "$ref": "#/$defs/metric" },
        "primaryRecheckCount": { "$ref": "#/$defs/count" }
      }
    },
    "latencyPercentiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50Ms", "p95Ms", "p99Ms"],
      "properties": {
        "p50Ms": { "$ref": "#/$defs/metric" },
        "p95Ms": { "$ref": "#/$defs/metric" },
        "p99Ms": { "$ref": "#/$defs/metric" }
      }
    },
    "totpLatency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizeInit",
        "totpStart",
        "totpVerify",
        "authorizeCode",
        "token",
        "totpCompletion",
        "fullFlow"
      ],
      "properties": {
        "authorizeInit": { "$ref": "#/$defs/latencyPercentiles" },
        "totpStart": { "$ref": "#/$defs/latencyPercentiles" },
        "totpVerify": { "$ref": "#/$defs/latencyPercentiles" },
        "authorizeCode": { "$ref": "#/$defs/latencyPercentiles" },
        "token": { "$ref": "#/$defs/latencyPercentiles" },
        "totpCompletion": { "$ref": "#/$defs/latencyPercentiles" },
        "fullFlow": { "$ref": "#/$defs/latencyPercentiles" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup", "measurement", "errors", "coldSamples"],
      "properties": {
        "warmup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationSeconds", "excludedFromMeasurement"],
          "properties": {
            "durationSeconds": { "const": 30 },
            "excludedFromMeasurement": { "const": true }
          }
        },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "durationSeconds",
            "ratePerSecond",
            "successCount",
            "failureCount",
            "droppedIterations",
            "p50Ms",
            "p95Ms",
            "p99Ms"
          ],
          "properties": {
            "durationSeconds": { "const": 300 },
            "ratePerSecond": { "type": "number", "minimum": 0 },
            "successCount": { "$ref": "#/$defs/count" },
            "failureCount": { "$ref": "#/$defs/count" },
            "droppedIterations": { "$ref": "#/$defs/count" },
            "p50Ms": { "$ref": "#/$defs/metric" },
            "p95Ms": { "$ref": "#/$defs/metric" },
            "p99Ms": { "$ref": "#/$defs/metric" }
          }
        },
        "errors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["routing5xx", "timeouts", "d1Overloaded"],
          "properties": {
            "routing5xx": { "$ref": "#/$defs/count" },
            "timeouts": { "$ref": "#/$defs/count" },
            "d1Overloaded": { "$ref": "#/$defs/count" }
          }
        },
        "coldSamples": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/coldSample" }
        },
        "trace": { "$ref": "#/$defs/trace" },
        "latencyMs": { "$ref": "#/$defs/totpLatency" }
      }
    },
    "identifierScenario": {
      "allOf": [
        { "$ref": "#/$defs/scenario" },
        { "not": { "required": ["latencyMs"] } },
        {
          "properties": {
            "measurement": {
              "properties": { "ratePerSecond": { "const": 50 } }
            }
          }
        }
      ]
    },
    "totpScenario": {
      "allOf": [
        { "$ref": "#/$defs/scenario" },
        {
          "required": ["latencyMs"],
          "properties": {
            "measurement": {
              "properties": { "ratePerSecond": { "const": 25 } }
            }
          }
        }
      ]
    }
  }
}
