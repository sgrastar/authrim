{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "authrim-admin-storybook",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./packages/ar-admin-console/storybook-static",
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "routes": [
    {
      "pattern": "admin.storybook.authrim.com",
      "custom_domain": true,
    },
  ],
}
